# Browser-side Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=talkshore-voyage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talkshore-voyage
VITE_FIREBASE_STORAGE_BUCKET=talkshore-voyage.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin credentials. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=talkshore-voyage
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated browser origins allowed to call /api/v1.
API_ALLOWED_ORIGINS=http://localhost:5173
API_VERSION=1.0.0
